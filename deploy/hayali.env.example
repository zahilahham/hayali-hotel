# Copy this to /opt/hayali/backend/.env and change the password.
# The server reads this file itself. Do not commit a filled-in copy.

# PostgreSQL. The database is created on first start when this account is allowed to.
DATABASE_URL=postgresql://hayali:change-me@127.0.0.1:5432/hayali

# Controllers send this. Leave it empty and any device on the network can call a room.
# Set it, then on each controller type: key <the same text>
HAYALI_DEVICE_KEY=

# Sets the reception password. Leave it empty to keep reception / reception@123.
HAYALI_DESK_PASSWORD=

# Address a phone uses for the room link. Leave it empty and the server detects one.
HAYALI_LAN_HOST=
